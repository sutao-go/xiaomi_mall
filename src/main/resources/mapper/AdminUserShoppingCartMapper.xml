<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.imooc.mapper.AdminUserShoppingCartMapper">

    <!--
        改造说明：
        本文件原本有十余条增删改查语句（查询购物车、改数量、计数、分页、查图片等），
        现已全部改用 MyBatis-Plus 实现，见 AdminUserShoppingCartImpl：
          - selectList / selectOne / selectCount / selectPage  -> 对应原 findimg、checkProductQuantity、
            queryShoppingRecords、queryProductInformation、countCart、queryProductInformationPage
          - insert / update(entity, wrapper)                     -> 对应原 settlement、addQuantity、updateQuantity
          - totalAmount 与 queryProductInformation 原本是两条完全相同的 SQL，已合并为一次调用

        仅保留 upsertShoppingCart：它使用 MySQL 的 INSERT ... ON DUPLICATE KEY UPDATE，
        一条 SQL 原子完成"有则累加、无则插入"，MyBatis-Plus 没有等价 API，因此保留在 XML 中。
        前置条件：表需有 (user_name, product_name) 唯一索引，否则会退化成重复插入。
    -->
    <insert id="upsertShoppingCart">
        insert into adminusershoppingcart(user_name,product_name,price,numbers_of_products)
        values (#{consumer,jdbcType=VARCHAR},
                #{productName,jdbcType=VARCHAR},
                #{price,jdbcType=VARCHAR},
                #{quantity,jdbcType=INTEGER})
        on duplicate key update
            numbers_of_products = numbers_of_products + #{quantity,jdbcType=INTEGER}
    </insert>

</mapper>
